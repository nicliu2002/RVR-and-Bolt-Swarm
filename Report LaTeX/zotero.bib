	pages = {904--911},
}

@inproceedings{pinciroli_coordinating_2010,
	address = {Berlin, Heidelberg},
	title = {Coordinating {Heterogeneous} {Swarms} through {Minimal} {Communication} among {Homogeneous} {Sub}-swarms},
	isbn = {978-3-642-15461-4},
	doi = {10.1007/978-3-642-15461-4_59},
	abstract = {In swarm robotics, the agents are often assumed to be identical. In this abstract, we argue that the cooperation between swarms of different kinds of robots can enhance the capabilities of the robotic system—heterogeneous swarms marry the robustness and parallelism of homogeneous swarms with efficient task specialisation. A key issue in heterogeneous swarm systems is the potential complexity of facilitating cooperation between the different robot types.},
